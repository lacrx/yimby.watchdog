#!/bin/bash
# Civic monitoring pipeline — three modes:
#
#   civic-pipeline full    — claude -p (subscription) + Whisper API.
#   civic-pipeline hybrid  — claude -p (subscription) + Whisper API.
#   civic-pipeline local   — claude -p (subscription) + faster-whisper. Zero API cost.
#
# Pipeline order: GATHER everything, THEN process.
#   Gather: fetch docs (9 agencies) → fetch permits → intel feeds → discover videos
#   Process: merge meetings → monthly rollup (meetings + permits + intel) → extract JSONL
#
# Options:
#   --deep              Download staff reports (not just agendas/minutes)
#   --force             Re-process already summarized/extracted documents
#   --years N           How many years back to fetch (default: 1)
#   --transcribe        Also transcribe meeting videos
#   --hot-only          Extract recent meetings only (skip backlog). Use for forward-facing cron.
#   --extract-until H   Stop cold extraction at hour H (0-23). Ignored with --hot-only.
#
# Cron (forward-facing; cold-queue backlog is handled by --extract-until / the default
# cold limit of 50 on non-hot-only runs):
#   0 1 * * *    cd ~/repos/yimby.watchdog && ./civic-pipeline local --deep --hot-only
#   0 18 * * 2-5 cd ~/repos/yimby.watchdog && ./civic-pipeline local --deep --hot-only

set -euo pipefail
cd "$(dirname "$0")"
export PATH="$HOME/.local/bin:$PATH"
source .venv/bin/activate
[ -f .env ] && set -a && source .env && set +a
unset ANTHROPIC_API_KEY  # extraction uses claude -p via subscription, not paid API

# ── Own process group ──
# Re-exec under setsid so the whole run (bash + python/claude children) is one
# session led by this PID. The next run can then kill the session (timeout puts its
# child in its own process group, so killing the group would miss wrapped scrapers).
# Skipped on a tty so manual runs keep Ctrl-C.
if [ -z "${CIVIC_PIPELINE_SETSID:-}" ] && [ ! -t 0 ] && command -v setsid >/dev/null 2>&1; then
    export CIVIC_PIPELINE_SETSID=1
    exec setsid --wait "$0" "$@"
fi

# ── Overlap protection ──
PIDFILE="data/.pipeline.pid"
if [ -f "$PIDFILE" ]; then
    OLD_PID=$(cat "$PIDFILE")
    if [ -n "$OLD_PID" ] && kill -0 "$OLD_PID" 2>/dev/null; then
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] Pipeline already running (PID $OLD_PID). Killing stale run."
        OLD_SID=$(ps -o sid= -p "$OLD_PID" 2>/dev/null | tr -d ' ' || true)
        if [ "$OLD_SID" = "$OLD_PID" ]; then
            # Session leader (setsid run): kill bash and every child in the session
            pkill -TERM -s "$OLD_PID" 2>/dev/null || true
            sleep 2
            pkill -KILL -s "$OLD_PID" 2>/dev/null || true
        else
            # Pre-setsid run: no group of its own; kill its children, then it
            pkill -TERM -P "$OLD_PID" 2>/dev/null || true
            kill "$OLD_PID" 2>/dev/null || true
            sleep 2
            pkill -KILL -P "$OLD_PID" 2>/dev/null || true
            kill -9 "$OLD_PID" 2>/dev/null || true
        fi
    fi
fi
echo $$ > "$PIDFILE"
trap 'rm -f "$PIDFILE"' EXIT

PHASE_TIMEOUT=1800  # 30 min max per scraper phase

# Runs a command under the phase timeout and returns its exit code (124 = timed out).
# Never logs; callers log, because the command's own output is redirected at the call site.
# Callers must not rely on set -e: use `if ! run_with_timeout ...; then` or `|| rc=$?`.
run_with_timeout() {
    local rc=0
    timeout -k 30 "$PHASE_TIMEOUT" "$@" < /dev/null || rc=$?
    return "$rc"
}

# Contract: "ERROR: <desc> failed (rc=N)" or "ERROR: <desc> timed out".
log_phase_error() {
    local desc="$1" rc="$2"
    if [ "$rc" -eq 124 ]; then
        log "ERROR: $desc timed out"
    else
        log "ERROR: $desc failed (rc=$rc)"
    fi
}

# Emit a "slug|..." list from agencies.yaml on stdout. Returns 1 (and logs ERROR
# to stderr) if python fails or the list is empty, so loops never silently run zero times.
load_list() {
    local desc="$1" code="$2" out rc=0
    out=$(python3 -c "$code") || rc=$?
    if [ "$rc" -ne 0 ] || [ -z "$out" ]; then
        log "ERROR: $desc agency list failed (rc=$rc, empty=$([ -z "$out" ] && echo yes || echo no))" >&2
        return 1
    fi
    printf '%s\n' "$out"
}

sync_to_s3() {
    local prefix="$1"; local local_path="$2"; local storage_class="${3:-STANDARD}"
    shift 3
    [ -z "${WATCHDOG_S3_BUCKET:-}" ] && return 0
    # --size-only only for large immutable raw files (PDFs, audio). Metadata,
    # operational and structured data are small and edited in place, often
    # without a size change, so they must compare timestamps.
    local size_only=()
    case "$prefix" in
        archive/*) size_only=(--size-only) ;;
    esac
    local rc=0
    aws s3 sync "$local_path" "s3://${WATCHDOG_S3_BUCKET}/${prefix}" \
        --storage-class "$storage_class" --no-progress "${size_only[@]}" \
        "$@" >> data/s3-sync.log 2>&1 || rc=$?
    if [ "$rc" -ne 0 ]; then
        log "ERROR: S3 sync of $prefix failed (rc=$rc)"
    fi
    return 0
}

s3_cp() {
    local src="$1" dest="$2" rc=0
    [ -z "${WATCHDOG_S3_BUCKET:-}" ] && return 0
    if [ ! -f "$src" ]; then
        log "ERROR: S3 copy of $src skipped: file missing"
        return 0
    fi
    aws s3 cp "$src" "s3://${WATCHDOG_S3_BUCKET}/${dest}" --quiet >> data/s3-sync.log 2>&1 || rc=$?
    if [ "$rc" -ne 0 ]; then
        log "ERROR: S3 copy of $src failed (rc=$rc)"
    fi
    return 0
}

MODE="${1:-hybrid}"
shift 2>/dev/null || true

DEEP=""
FORCE=""
YEARS="1"
TRANSCRIBE=""
EXTRACT_CUTOFF=""
HOT_ONLY=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --deep)           DEEP="--deep"; shift ;;
        --force)          FORCE="--force"; shift ;;
        --years)          YEARS="$2"; shift 2 ;;
        --transcribe)     TRANSCRIBE="1"; shift ;;
        --extract-until)  EXTRACT_CUTOFF="$2"; shift 2 ;;
        --hot-only)       HOT_ONLY="1"; shift ;;
        *)                echo "Unknown option: $1"; exit 1 ;;
    esac
done

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [$MODE] $*"
}

case "$MODE" in
    full|hybrid|local) ;;
    sync-and-extract)
        # AWS split mode: pull from S3, extract locally, push back
        exec ./extract-local $FORCE $([ -n "$EXTRACT_CUTOFF" ] && echo "--extract-until $EXTRACT_CUTOFF")
        ;;
    *) echo "Usage: civic-pipeline <full|hybrid|local|sync-and-extract> [--deep] [--force] [--years N] [--transcribe] [--extract-until H]"
       echo ""
       echo "Modes:"
       echo "  full              — Claude API + Whisper API (bulk, ~\$44/full-run)"
       echo "  hybrid            — claude -p + Whisper API (daily, ~\$0.90/meeting transcription only)"
       echo "  local             — claude -p + faster-whisper (zero API cost)"
       echo "  sync-and-extract  — Pull from S3, extract via claude -p, push back (AWS split mode)"
       exit 1 ;;
esac

case "$MODE" in
    full)          ;; # Whisper API
    hybrid|local)  ;; # faster-whisper
esac

log "Starting civic pipeline (mode=$MODE)"

# ═══════════════════════════════════════════
# PHASE 0: PREFLIGHT — verify endpoints before fetching
# ═══════════════════════════════════════════

log "Running preflight health checks..."
PREFLIGHT_RC=0
python3 pipeline_preflight.py >> data/preflight.log 2>&1 || PREFLIGHT_RC=$?
if [ "$PREFLIGHT_RC" -eq 2 ]; then
    log "PREFLIGHT ABORT: All agencies failing — likely network issue. Stopping pipeline."
    exit 1
elif [ "$PREFLIGHT_RC" -eq 1 ]; then
    log "Preflight: some agencies unhealthy (see data/preflight.log). Continuing with healthy ones."
fi
log "Preflight done."

# ═══════════════════════════════════════════
# PHASE 1: GATHER — collect all raw sources
# ═══════════════════════════════════════════

# ── 1a: Fetch meeting documents (all enabled agencies) ──
AGENCY_LIST=$(load_list "Meeting fetch" "
import math, yaml
from datetime import date
cfg = yaml.safe_load(open('agencies.yaml'))
today = date.today()
for slug, a in cfg['agencies'].items():
    if a.get('enabled', True):
        lb = a.get('lookback_months')
        # history_start is an absolute floor: how far back we intend to hold
        # this agency. A rolling lookback_months window cannot express that —
        # its start date creeps forward every night, so history silently falls
        # out of range. Whichever reaches further back wins.
        hs = a.get('history_start')
        if hs:
            hs = hs if isinstance(hs, date) else date.fromisoformat(str(hs))
            months = (today.year - hs.year) * 12 + today.month - hs.month
            lb = max(lb or 0, months)
        # Floor at 3 months so the listing still covers the 90-day recheck
        # window (civic_utils.RECHECK_DAYS) for late-posted documents.
        lb = max(lb, 3) if lb else lb
        yi = str(-(-lb // 12)) if lb else ''
        yf = str(math.ceil(lb / 12 * 10000) / 10000) if lb else ''
        print(f\"{slug}|{a['platform']}|{a.get('name', slug)}|{yi}|{yf}\")
") || AGENCY_LIST=""
if [ -n "$AGENCY_LIST" ]; then
while IFS='|' read -r SLUG PLATFORM NAME AGENCY_YEARS AGENCY_YEARS_F; do
    LOG_FILE="data/${SLUG}/watch.log"
    mkdir -p "data/${SLUG}"
    AGENCY_DEEP=""
    # Only pass --deep to agencies configured for it
    if python3 -c "import yaml; c=yaml.safe_load(open('agencies.yaml')); exit(0 if c['agencies']['$SLUG'].get('deep_fetch') else 1)" 2>/dev/null; then
        AGENCY_DEEP="$DEEP"
    fi
    # Per-agency lookback: use agency's lookback_months if set, else global --years
    # Scrapers that parse --years as a float get the exact fraction of a year
    # (lookback_months/12); the int-only ones (oceanside, sdcounty, sandag,
    # coastal, primegov) get it rounded up to whole years. nctd takes neither.
    FETCH_YEARS="${AGENCY_YEARS:-$YEARS}"
    FETCH_YEARS_F="${AGENCY_YEARS_F:-$YEARS}"
    FETCH_CMD=()

    log "Fetching $NAME meetings (${FETCH_YEARS}y lookback)..."
    case "$PLATFORM" in
        legistar_html)
            FETCH_CMD=(python3 scrapers/oceanside.py fetch $AGENCY_DEEP --years "$FETCH_YEARS")
            ;;
        legistar_odata)
            FETCH_CMD=(python3 scrapers/sdcounty.py fetch --years "$FETCH_YEARS")
            ;;
        escribe)
            FETCH_CMD=(python3 scrapers/sandag.py fetch --agency "$SLUG" --years "$FETCH_YEARS")
            ;;
        custom_html)
            FETCH_CMD=(python3 scrapers/nctd.py fetch)
            ;;
        coastal_api)
            FETCH_CMD=(python3 scrapers/coastal.py fetch --years "$FETCH_YEARS")
            ;;
        granicus)
            FETCH_CMD=(python3 scrapers/granicus.py fetch --agency "$SLUG" $AGENCY_DEEP --years "$FETCH_YEARS_F")
            ;;
        civicplus)
            FETCH_CMD=(python3 scrapers/civicplus.py fetch --agency "$SLUG" $AGENCY_DEEP --years "$FETCH_YEARS_F")
            ;;
        civicclerk)
            FETCH_CMD=(python3 scrapers/civicclerk.py fetch --agency "$SLUG" $AGENCY_DEEP --years "$FETCH_YEARS_F")
            ;;
        carlsbad_cms)
            FETCH_CMD=(python3 scrapers/carlsbad.py fetch $AGENCY_DEEP --years "$FETCH_YEARS_F")
            ;;
        swagit)
            FETCH_CMD=(python3 scrapers/swagit.py fetch --agency "$SLUG" $AGENCY_DEEP --years "$FETCH_YEARS_F")
            ;;
        solana_drupal)
            FETCH_CMD=(python3 scrapers/solana_beach.py fetch $AGENCY_DEEP --years "$FETCH_YEARS_F")
            ;;
        municode)
            FETCH_CMD=(python3 scrapers/municode.py fetch --agency "$SLUG" $AGENCY_DEEP --years "$FETCH_YEARS_F")
            ;;
        primegov)
            FETCH_CMD=(python3 scrapers/primegov.py fetch --agency "$SLUG" --years "$FETCH_YEARS")
            ;;
        lemon_grove_events)
            FETCH_CMD=(python3 scrapers/lemon_grove.py fetch --years "$FETCH_YEARS_F")
            ;;
        santee_cms)
            FETCH_CMD=(python3 scrapers/santee.py fetch $AGENCY_DEEP --years "$FETCH_YEARS_F")
            ;;
        elcajon_cms)
            FETCH_CMD=(python3 scrapers/elcajon.py fetch --years "$FETCH_YEARS_F")
            ;;
        laserfiche)
            FETCH_CMD=(python3 scrapers/laserfiche.py fetch --agency "$SLUG" --years "$FETCH_YEARS_F")
            ;;
        *)
            log "  $NAME: unknown platform '$PLATFORM', skipping."
            ;;
    esac
    if [ "${#FETCH_CMD[@]}" -gt 0 ]; then
        FETCH_RC=0
        run_with_timeout "${FETCH_CMD[@]}" >> "$LOG_FILE" 2>&1 || FETCH_RC=$?
        if [ "$FETCH_RC" -ne 0 ]; then
            log_phase_error "$NAME fetch" "$FETCH_RC"
        else
            log "$NAME fetch done."
        fi
    fi
done <<< "$AGENCY_LIST"
fi

# ── 1b: Intel feed — check RSS/web for relevant items ──
log "Checking intel feeds..."
INTEL_RC=0
run_with_timeout python3 scrapers/intel_feed.py >> data/intel/feed.log 2>&1 || INTEL_RC=$?
if [ "$INTEL_RC" -ne 0 ]; then log_phase_error "Intel feed" "$INTEL_RC"; else log "Intel feed done."; fi

# ── 1c: Fetch building permits (agencies with permit config) ──
CURRENT_YEAR=$(date '+%Y')
PREV_YEAR=$((CURRENT_YEAR - 1))
# Previous year too: incremental scans are cheap, and permits/projects filed in
# late December are otherwise missed once the calendar rolls over.
PERMIT_YEARS="$PREV_YEAR $CURRENT_YEAR"
PERMIT_LIST=$(load_list "Permit fetch" "
import yaml
cfg = yaml.safe_load(open('agencies.yaml'))
for slug, a in cfg['agencies'].items():
    if a.get('enabled', True) and a.get('permits'):
        platform = a['permits'].get('platform', 'etrakit')
        print(f\"{slug}|{a.get('name', slug)}|{platform}\")
") || PERMIT_LIST=""
if [ -n "$PERMIT_LIST" ]; then
while IFS='|' read -r SLUG NAME PLATFORM; do
    mkdir -p "data/${SLUG}/permits"
    for YEAR in $PERMIT_YEARS; do
        log "Fetching $NAME permits ($YEAR, $PLATFORM, incremental)..."
        case "$PLATFORM" in
            etrakit)
                CMD=(python3 scrapers/etrakit.py fetch --agency "$SLUG" --year "$YEAR")
                ;;
            arcgis)
                CMD=(python3 scrapers/arcgis_permits.py fetch --agency "$SLUG" --year "$YEAR")
                ;;
            *)
                log "  $NAME: unknown permit platform '$PLATFORM', skipping."
                break
                ;;
        esac
        PERMIT_RC=0
        run_with_timeout "${CMD[@]}" >> "data/${SLUG}/permits/fetch.log" 2>&1 || PERMIT_RC=$?
        if [ "$PERMIT_RC" -ne 0 ]; then
            log_phase_error "$NAME permits ($YEAR)" "$PERMIT_RC"
        else
            log "$NAME permits done."
        fi
    done
done <<< "$PERMIT_LIST"
fi

# ── 1c.1: Fetch planning projects (eTRAKit only — development plans, density bonus, etc) ──
ETRAKIT_LIST=$(load_list "eTRAKiT" "
import yaml
cfg = yaml.safe_load(open('agencies.yaml'))
for slug, a in cfg['agencies'].items():
    if a.get('enabled', True) and a.get('permits'):
        if a['permits'].get('platform') == 'etrakit':
            print(f\"{slug}|{a.get('name', slug)}\")
") || ETRAKIT_LIST=""
if [ -n "$ETRAKIT_LIST" ]; then
while IFS='|' read -r SLUG NAME; do
    for YEAR in $PERMIT_YEARS; do
        log "Fetching $NAME planning projects ($YEAR)..."
        PROJ_RC=0
        run_with_timeout python3 scrapers/etrakit.py projects --agency "$SLUG" --year "$YEAR" --delay 0.5 >> "data/${SLUG}/permits/projects.log" 2>&1 || PROJ_RC=$?
        if [ "$PROJ_RC" -ne 0 ]; then
            log_phase_error "$NAME projects ($YEAR)" "$PROJ_RC"
        else
            log "$NAME projects done."
        fi
    done
done <<< "$ETRAKIT_LIST"
fi

# ── 1c.2: Enrich new infill permits (eTRAKit only — contacts, site info, linked activities) ──
if [ -n "$ETRAKIT_LIST" ]; then
while IFS='|' read -r SLUG NAME; do
    log "Enriching $NAME infill permits ($CURRENT_YEAR)..."
    ENRICH_RC=0
    run_with_timeout python3 scrapers/etrakit.py enrich --agency "$SLUG" --year "$CURRENT_YEAR" --infill --delay 1.5 >> "data/${SLUG}/permits/enrich.log" 2>&1 || ENRICH_RC=$?
    if [ "$ENRICH_RC" -ne 0 ]; then
        log_phase_error "$NAME permit enrichment" "$ENRICH_RC"
    else
        log "$NAME permit enrichment done."
    fi
done <<< "$ETRAKIT_LIST"
fi

# ── 1c.3: Refresh status of open permits/projects (eTRAKit only, nightly run) ──
# fetch/projects only add new numbers; without this, status and issued/finaled
# dates stay frozen at first sight. Rotates through ~300 open records per night.
if [ -z "$HOT_ONLY" ] && [ -n "$ETRAKIT_LIST" ]; then
while IFS='|' read -r SLUG NAME; do
    log "Refreshing $NAME permit/project status..."
    REFRESH_RC=0
    # 0.5s delay: ~600 requests per agency, so ~5 min instead of ~15
    run_with_timeout python3 scrapers/etrakit.py refresh --agency "$SLUG" --batch 300 --delay 0.5 >> "data/${SLUG}/permits/refresh.log" 2>&1 || REFRESH_RC=$?
    if [ "$REFRESH_RC" -ne 0 ]; then
        log_phase_error "$NAME status refresh" "$REFRESH_RC"
    else
        log "$NAME status refresh done."
    fi
done <<< "$ETRAKIT_LIST"
fi

# ── 1d: Discover new meeting videos ──
log "Discovering new meeting videos..."
VIDEO_RC=0
run_with_timeout python3 scrapers/discover_videos.py >> data/video-discovery.log 2>&1 || VIDEO_RC=$?
if [ "$VIDEO_RC" -ne 0 ]; then log_phase_error "Video discovery" "$VIDEO_RC"; else log "Video discovery done."; fi

# ── 1e: Transcribe audio (if enabled) ──
# Only transcribe high-priority meetings by default (City Council, Planning Commission,
# or meetings with housing/zoning keyword hits in agenda text).
# Full/hybrid modes use Whisper API (~$0.006/min); local uses faster-whisper (free).
if [ -n "$TRANSCRIBE" ]; then
    if [ ! -f data/transcribe-batch.json ]; then
        log "  No data/transcribe-batch.json found. Skipping transcription."
    else
        # Filter batch to high-priority meetings only (unless --force)
        BATCH_FILE="data/transcribe-batch.json"
        if [ -z "$FORCE" ]; then
            FILTERED_FILE="data/transcribe-batch-filtered.json"
            python3 -c "
import json
batch = json.loads(open('$BATCH_FILE').read())
high = [e for e in batch if e.get('priority', 'high') == 'high']
low = [e for e in batch if e.get('priority') == 'low']
if low:
    print(f'  Skipping {len(low)} low-priority meetings (use --force to include all)')
open('$FILTERED_FILE', 'w').write(json.dumps(high, indent=2))
print(f'  {len(high)} high-priority meetings to transcribe')
" >> data/transcribe.log 2>&1
            BATCH_FILE="$FILTERED_FILE"
        fi
        BATCH_COUNT=$(python3 -c "import json; b=json.loads(open('$BATCH_FILE').read()); print(len(b))" 2>/dev/null || echo 0)
        log "  Transcribing $BATCH_COUNT meetings"
        if [ "$BATCH_COUNT" -gt 0 ] 2>/dev/null; then
            TRANSCRIBE_OK=true
            case "$MODE" in
                full|hybrid)
                    log "  Transcribing with Whisper API..."
                    python3 transforms/transcribe.py --batch "$BATCH_FILE" \
                        >> data/transcribe.log 2>&1 || TRANSCRIBE_OK=false
                    ;;
                local)
                    log "  Transcribing with faster-whisper (local)..."
                    python3 transforms/transcribe_local.py batch "$BATCH_FILE" \
                        >> data/transcribe.log 2>&1 || TRANSCRIBE_OK=false
                    ;;
            esac
            if [ "$TRANSCRIBE_OK" = true ]; then
                log "Transcription done."
            else
                log "Transcription failed — continuing with extraction."
            fi
        else
            log "  No high-priority meetings to transcribe."
        fi
    fi
fi

# ── S3 sync: raw sources ──
if [ -n "${WATCHDOG_S3_BUCKET:-}" ]; then
    log "Syncing raw sources to S3..."
    # Per-agency documents and meetings
    S3_LIST=$(load_list "S3 sync" "
import yaml
cfg = yaml.safe_load(open('agencies.yaml'))
for slug, a in cfg['agencies'].items():
    if a.get('enabled', True):
        print(f\"{slug}|{a.get('name', slug)}\")
") || S3_LIST=""
    while IFS='|' read -r SLUG _; do
        [ -z "$SLUG" ] && continue
        if [ -d "data/${SLUG}/documents" ]; then
            sync_to_s3 "archive/${SLUG}/documents/pdfs" "data/${SLUG}/documents" "STANDARD" --exclude "*.txt" --exclude "*.skip" --exclude "*.json"
            sync_to_s3 "raw/${SLUG}/documents/txt" "data/${SLUG}/documents" "STANDARD_IA" --exclude "*.pdf" --exclude "*.skip" --exclude "*.json"
        fi
        if [ -f "data/${SLUG}/doc-index.json" ]; then
            s3_cp "data/${SLUG}/doc-index.json" "raw/${SLUG}/doc-index.json"
        fi
        if [ -d "data/${SLUG}/meetings" ]; then
            sync_to_s3 "metadata/${SLUG}/meetings" "data/${SLUG}/meetings" "STANDARD"
        fi
        if [ -d "data/${SLUG}/permits" ]; then
            sync_to_s3 "operational/${SLUG}/permits" "data/${SLUG}/permits" "STANDARD"
        fi
    done <<< "$S3_LIST"
    # Shared resources
    sync_to_s3 "archive/audio" "data/audio" "STANDARD"
    sync_to_s3 "operational/intel" "data/intel" "STANDARD"
    sync_to_s3 "raw/transcripts" "data/transcripts" "STANDARD_IA"
    log "S3 sync (raw) done."
fi

# ═══════════════════════════════════════════
# PHASE 2: PROCESS — merge and roll up existing records
# ═══════════════════════════════════════════

# ── 2a: Merge per-document records into per-meeting records ──
log "Merging per-meeting records..."
MERGE_RC=0
python3 transforms/meeting_merge.py >> data/meeting-merge.log 2>&1 || MERGE_RC=$?
if [ "$MERGE_RC" -ne 0 ]; then
    log "WARNING: Meeting merge failed (exit $MERGE_RC). Continuing pipeline."
fi
log "Meeting merge done."

# ── 2b: Group permits into projects ──
log "Building permit project groupings..."
python3 transforms/permit_projects.py >> data/permit-projects.log 2>&1 || log "WARNING: Permit project grouping failed. Continuing pipeline."
log "Permit project grouping done."

# ── 2b.1: Enrich permits with GIS zoning data ──
log "Enriching permits with zoning data..."
ZONE_RC=0
run_with_timeout python3 transforms/enrich_permits.py enrich --year "$CURRENT_YEAR" \
    >> data/enrich-permits.log 2>&1 || ZONE_RC=$?
if [ "$ZONE_RC" -ne 0 ]; then log_phase_error "Zone enrichment" "$ZONE_RC"; else log "Zone enrichment done."; fi

# ── 2b.2: HCD APR filings (monthly — runs on 1st of each month) ──
if [ "$(date +%d)" = "01" ]; then
    log "Monthly APR refresh..."
    if python3 loaders/hcd_apr.py download >> data/hcd-apr.log 2>&1 && \
       python3 loaders/hcd_apr.py enrich  >> data/hcd-apr.log 2>&1 && \
       python3 loaders/hcd_apr.py crossref >> data/hcd-apr.log 2>&1; then
        log "APR download + enrich + crossref done."
    else
        log "WARNING: APR refresh failed. Continuing pipeline."
    fi
fi

# ── 2b.3: Build unified housing projects ──
log "Building unified housing projects..."
python3 transforms/housing_projects.py >> data/housing-projects.log 2>&1 || log "WARNING: Housing projects build failed."

# ── 2b.4: Export permits + filings to Parquet + upload to S3 ──
log "Exporting permits to Parquet..."
if AWS_PROFILE="${AWS_PROFILE:-civic}" python3 transforms/export_parquet.py >> data/export-parquet.log 2>&1; then
    log "Parquet export + upload done."
else
    log "WARNING: Parquet export failed. Continuing pipeline."
fi

# ── 2c: Monthly rollups (auto-detects stale months) ──
log "Building monthly digests..."
python3 transforms/monthly_rollup.py >> data/monthly-rollup.log 2>&1 || log "WARNING: Monthly rollup failed. Continuing pipeline."
log "Monthly rollups done."

# ═══════════════════════════════════════════
# PHASE 3a: HOT EXTRACT — recent meetings, must complete
# ═══════════════════════════════════════════
# Documents from meetings in the last 14 days. No time limit — these
# must always be processed. Failures are logged loudly.

python3 transforms/extract_structured.py --tally >> data/structured-extraction.log 2>&1 || true

EXTRACT_BEFORE=$(find data/structured -name '*.json' 2>/dev/null | wc -l)

log "Hot extraction (last 14 days)..."
HOT_RC=0
python3 transforms/extract_structured.py --queue hot $FORCE >> data/structured-extraction.log 2>&1 || HOT_RC=$?

EXTRACT_AFTER_HOT=$(find data/structured -name '*.json' 2>/dev/null | wc -l)
HOT_EXTRACTIONS=$((EXTRACT_AFTER_HOT - EXTRACT_BEFORE))

if [ "$HOT_RC" -ne 0 ]; then
    log "WARNING: Hot extraction failed (exit $HOT_RC). Check data/structured-extraction.log"
fi
log "Hot extraction done: $HOT_EXTRACTIONS new."

# ═══════════════════════════════════════════
# PHASE 3b: COLD EXTRACT — backlog, time-bounded, optional
# ═══════════════════════════════════════════
# Only runs if hot succeeded and time remains. Oldest-first.
# Failures are quiet — backlog can wait.

if [ -n "$HOT_ONLY" ]; then
    log "Skipping cold extraction (--hot-only)."
elif [ "$HOT_RC" -eq 0 ] && [ -n "$EXTRACT_CUTOFF" ]; then
    CURRENT_HOUR=$(date +%H)
    if [ "$CURRENT_HOUR" -lt "$EXTRACT_CUTOFF" ]; then
        log "Cold extraction (backlog, until ${EXTRACT_CUTOFF}:00)..."
        python3 transforms/extract_structured.py --queue cold --stop-at "$EXTRACT_CUTOFF" --skip-forward-backlog $FORCE \
            >> data/structured-extraction.log 2>&1 || true
        log "Cold extraction done."
    else
        log "No time remaining for cold extraction."
    fi
elif [ "$HOT_RC" -eq 0 ] && [ -z "$EXTRACT_CUTOFF" ]; then
    log "Cold extraction (backlog, limit 50)..."
    python3 transforms/extract_structured.py --queue cold --limit 50 --skip-forward-backlog $FORCE \
        >> data/structured-extraction.log 2>&1 || true
    log "Cold extraction done."
fi

EXTRACT_AFTER=$(find data/structured -name '*.json' 2>/dev/null | wc -l)
NEW_EXTRACTIONS=$((EXTRACT_AFTER - EXTRACT_BEFORE))

if [ "$NEW_EXTRACTIONS" -gt 0 ]; then
    log "Extractions: $HOT_EXTRACTIONS hot + $((NEW_EXTRACTIONS - HOT_EXTRACTIONS)) cold = $NEW_EXTRACTIONS total."
else
    log "No new extractions."
fi

# ── S3 sync: structured data ──
if [ -n "${WATCHDOG_S3_BUCKET:-}" ]; then
    log "Syncing structured data to S3..."
    sync_to_s3 "structured/records" "data/structured" "STANDARD" --exclude "meetings/*" --exclude "monthly/*" --exclude "*.jsonl" --exclude "*.log" --exclude "*.skip" --exclude "*.chunks"
    sync_to_s3 "structured/meetings" "data/structured/meetings" "STANDARD"
    sync_to_s3 "structured/monthly" "data/structured/monthly" "STANDARD"
    s3_cp data/structured/all-records.jsonl "structured/all-records.jsonl"
    s3_cp data/structured/meetings-combined.jsonl "structured/meetings-combined.jsonl"
    log "S3 sync (structured) done."
fi

# ═══════════════════════════════════════════
# PHASE 5: DOCTOR — diagnose errors and self-heal
# ═══════════════════════════════════════════

log "Running pipeline doctor..."
DOCTOR_RC=0
run_with_timeout python3 pipeline_doctor.py >> data/pipeline-doctor-run.log 2>&1 || DOCTOR_RC=$?
if [ "$DOCTOR_RC" -ne 0 ]; then log_phase_error "Pipeline doctor" "$DOCTOR_RC"; else log "Doctor done."; fi

log "Pipeline complete."
